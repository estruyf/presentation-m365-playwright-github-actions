{
  "$schema": "https://elio.dev/demo-time.schema.json",
  "title": "2.automation",
  "description": "",
  "version": 2,
  "demos": [
    {
      "title": "Automation",
      "description": "",
      "steps": [
        {
          "action": "openSlide",
          "path": "/.demo/slides/automation.md"
        }
      ],
      "icons": {
        "start": "vm",
        "end": "pass-filled"
      }
    },
    {
      "id": "2.automation.show_repository",
      "title": "The repository",
      "steps": [
        {
          "action": "openWebsite",
          "url": "https://github.com/estruyf/presentation-m365-playwright-github-actions"
        }
      ]
    },
    {
      "title": "Configure the TOPT",
      "steps": [
        {
          "action": "openWebsite",
          "url": "https://github.com/estruyf/presentation-m365-playwright-github-actions/settings/secrets/actions"
        }
      ]
    },  
    {
      "title": "The workflow",
      "description": "",
      "steps": [
        {
          "action": "openSlide",
          "path": "/.demo/slides/the-workflow.md"
        }
      ],
      "icons": {
        "start": "vm",
        "end": "pass-filled"
      }
    },
    {
      "id": "2.automation.create_workflow",
      "title": "Create workflow",
      "steps": [
        {
          "action": "create",
          "path": ".github/workflows/e2e.yml",
          "contentPath": ".demo/2.automation/step1.yml"
        },
        {
          "action": "open",
          "path": ".github/workflows/e2e.yml"
        }
      ]
    },
    {
      "title": "4. Highlight work dir",
      "steps": [
        {
          "action": "highlight",
          "path": ".github/workflows/e2e.yml",
          "position": "15:17"
        }
      ]
    },
    {
      "title": "🪧 Step 3",
      "steps": [
        {
          "action": "snippet",
          "contentPath": "./defaults/show_slide.json",
          "args": {
            "SLIDES_URL": "http://localhost:3030/39"
          }
        }
      ]
    },
    {
      "id": "2.automation.add_playwright",
      "title": "5. Add Playwright",
      "steps": [
        {
          "action": "executeVSCodeCommand",
          "command": "workbench.action.toggleSidebarVisibility"
        },
        {
          "action": "snippet",
          "contentPath": "./defaults/insert_and_highlight.json",
          "args": {
            "MAIN_FILE": ".github/workflows/e2e.yml",
            "CONTENT_PATH": "2.automation/step3.yml",
            "CONTENT_POSITION": "22",
            "HIGHLIGHT_POSITION": ""
          }
        }
      ]
    },
    {
      "title": "🪧 First run",
      "steps": [
        {
          "action": "snippet",
          "contentPath": "./defaults/show_slide.json",
          "args": {
            "SLIDES_URL": "http://localhost:3030/45"
          }
        }
      ]
    }
  ]
}