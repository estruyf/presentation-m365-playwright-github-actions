{
  "$schema": "https://elio.dev/demo-time.schema.json",
  "title": "4.reporting",
  "description": "",
  "version": 2,
  "demos": [
    {
      "title": "Reporting",
      "description": "",
      "steps": [
        {
          "action": "openSlide",
          "path": "/.demo/slides/reporting.md"
        }
      ],
      "icons": {
        "start": "vm",
        "end": "pass-filled"
      }
    },
    {
      "id": "4.reporting.github_actions_reporter",
      "title": "Add GH Actions Reporter",
      "steps": [
        {
          "action": "snippet",
          "contentPath": ".demo/defaults/insert_and_highlight.json",
          "args": {
            "MAIN_FILE": "e2e/playwright.config.ts",
            "CONTENT_PATH": ".demo/4.reporting/step1.ts",
            "CONTENT_POSITION": "70",
            "HIGHLIGHT_POSITION": "71:79"
          }
        }
      ]
    },
    {
      "title": "Update workflow",
      "steps": [
        {
          "action": "create",
          "path": ".github/workflows/e2e.yml",
          "contentPath": ".demo/4.reporting/step2.yml"
        },
        {
          "action": "open",
          "path": ".github/workflows/e2e.yml"
        },
        {
          "action": "waitForTimeout",
          "timeout": 500
        },
        {
          "action": "highlight",
          "position": "51:56",
          "path": ".github/workflows/e2e.yml",
          "zoom": 4
        }
      ]
    },
    {
      "title": "Notifying",
      "description": "",
      "steps": [
        {
          "action": "openSlide",
          "path": "/.demo/slides/notifying.md"
        }
      ],
      "icons": {
        "start": "vm",
        "end": "pass-filled"
      }
    },
    {
      "id": "4.reporting.webhook_creation",
      "title": "Webhook creation",
      "steps": [
        {
          "action": "openWebsite",
          "url": "https://make.preview.powerautomate.com/galleries/public/templates/d271a6f01c2545a28348d8f2cddf4c8f/post-to-a-channel-when-a-webhook-request-is-received"
        }
      ]
    },
    {
      "title": "Add reporter",
      "steps": [
        {
          "action": "snippet",
          "contentPath": ".demo/defaults/insert_and_highlight.json",
          "args": {
            "MAIN_FILE": "e2e/playwright.config.ts",
            "CONTENT_PATH": ".demo/4.reporting/step3.ts",
            "CONTENT_POSITION": "79",
            "HIGHLIGHT_POSITION": "88:96"
          }
        }
      ]
    },
    {
      "title": "Update workflow",
      "steps": [
        {
          "action": "snippet",
          "contentPath": ".demo/defaults/insert_and_highlight.json",
          "args": {
            "MAIN_FILE": ".github/workflows/e2e.yml",
            "CONTENT_PATH": ".demo/4.reporting/step4.yml",
            "CONTENT_POSITION": "51",
            "HIGHLIGHT_POSITION": "52:52"
          }
        }
      ]
    },
    {
      "title": "Commit and run",
      "steps": [
        {
          "action": "executeVSCodeCommand",
          "command": "workbench.action.terminal.killAll"
        },
        {
          "action": "executeTerminalCommand",
          "command": "git add . && git commit -m 'Reporting' && git push && gh browse -n | xargs -I {} echo {}/actions | xargs open"
        }
      ]
    },
    {
      "title": "Verify MS Teams",
      "steps": [
        {
          "action": "openWebsite",
          "url": "https://teams.microsoft.com/l/channel/19%3A99bd70fca53d42f98d06a77ed3254294%40thread.tacv2/General?groupId=0daed572-448a-4d0a-8ea8-b6a49e4625b3&tenantId=b32d3268-2794-435f-865f-ab4779cae11e"
        }
      ]
    }
  ]
}